#!/bin/bash
set -e

# Build and install Flatpak package locally for testing
echo "Building Flatpak package..."
flatpak-builder --user --install --repo=.repo --force-clean .build-dir packaging/flatpak/org.cogstat.cogstat.yaml
flatpak build-bundle .repo cogstat.flatpak org.cogstat.cogstat

echo "Done! You can run the application with:"
echo "flatpak run org.cogstat.cogstat"
